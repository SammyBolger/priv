# copy this file to .env and fill in real values.
# .env is gitignored so secrets never get committed.

# LLM settings. LITELLM_API_KEY falls back to GITHUB_TOKEN if not set.
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=

# optional overrides
# LITELLM_TEMPERATURE=0.2
# PORT=3001
# DOCS_DIR=../frontend/docs
